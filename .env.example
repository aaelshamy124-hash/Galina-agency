# ==============================================================================
# Environment Configuration for Galina Smart Export AI
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (autonomous market research,
# intent signal generation, and B2B multilingual email pitches).
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# For local development: http://localhost:3000
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000
